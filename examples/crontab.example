# Agent Wellbeing Kit - cron schedule
# Copy these lines to your crontab: crontab -e
# Calling through /bin/bash works even if the download lost the executable bit.
# If you change routine.wake_time or routine.bedtime in config.json, move the
# 07:00/08:00 or 23:00 lines to the same hours.

0 7 * * *   /bin/bash /path/to/agent-wellbeing-kit/dispatch.sh
0 8 * * 1-5 /bin/bash /path/to/agent-wellbeing-kit/dispatch.sh
30 19 * * * /bin/bash /path/to/agent-wellbeing-kit/dispatch.sh
0 23 * * *  /bin/bash /path/to/agent-wellbeing-kit/dispatch.sh
